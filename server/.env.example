# ---- Server ----
NODE_ENV=development
PORT=5000
# Comma separated list of allowed frontend origins (CORS)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- MongoDB ----
MONGODB_URI=mongodb://127.0.0.1:27017/admin_panel

# ---- Auth ----
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Allow anyone to self-register from the Sign Up page (creates role=employee)
ALLOW_PUBLIC_SIGNUP=false

# ---- Misc ----
# Timezone used to decide "today" for attendance punches
APP_TIMEZONE=Asia/Kolkata
# Weekly target hours shown on My Attendance
WEEKLY_TARGET_HOURS=48

# ---- Salary slips, Performance Appraisal Letters, Form 16 ----
# AES-256-GCM key (64 hex chars) used to encrypt PDFs at rest. REQUIRED in production; never change it
# after slips exist (they could no longer be decrypted). Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SALARY_ENCRYPTION_KEY=
# Max PDF size (MB) for salary slips, Performance Appraisal Letters and Form 16
SALARY_SLIP_MAX_MB=5

# ---- Photo gallery ----
# Max size of one uploaded photo (MB). Browsers also send a screen-sized and a thumbnail copy.
GALLERY_MAX_MB=15
# Signed image URLs stay valid for between 1x and 2x this many hours (1-72)
GALLERY_URL_TTL_HOURS=6

# ---- HR policies & tickets ----
# Max size of one policy document (MB)
POLICY_MAX_MB=20
# Ticket attachments: max size per file (MB) and files per message
TICKET_ATTACHMENT_MAX_MB=10
TICKET_MAX_FILES=5

# Swagger UI at /api/docs (always on outside production)
ENABLE_DOCS=false

# ---- Seed (npm run seed) ----
SEED_PASSWORD=ChangeMe@123
